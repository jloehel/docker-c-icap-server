# shellcheck shell=bash
# This file is sourced, not executed directly

[[ ${BASH_DEBUG:-false} = true ]] && set -x

# Constants
MODULE="$(basename "$0")"

# Color Palette
RESET='\033[0m'
BOLD='\033[1m'

## Foreground
RED='\033[38;5;1m'
GREEN='\033[38;5;2m'
YELLOW='\033[38;5;3m'
BLUE='\033[38;5;4m'
MAGENTA='\033[38;5;5m'
CYAN='\033[38;5;6m'

########################
# Print to STDERR
#########################
stderr_print() {
    printf "%b\\n" "${*}" >&2
}

########################
# Log message
#########################
log() {
    stderr_print "${CYAN}${MODULE:-} ${MAGENTA}$(date "+%T.%2N ")${RESET}${*}"
}

########################
# Log an 'info' message
#########################
info() {
    log "${GREEN}INFO ${RESET} ==> ${*}"
}

########################
# Log a 'warn' message
#########################
warn() {
    log "${YELLOW}WARN ${RESET} ==> ${*}"
}

########################
# Log an 'error' message
#########################
error() {
    log "${RED}ERROR${RESET} ==> ${*}"
}

########################
# Log a 'debug' message
#########################
debug() {
    if [[ "${CICAP_DEBUG:-false}" == "true" ]]; then
        log "${BLUE}DEBUG${RESET} ==> ${*}"
    fi
}

########################
# Print the welcome page
#########################
print_welcome_page() {
    if [[ -z "${DISABLE_WELCOME_MESSAGE:-}" ]]; then
        if [[ -n "${APP_NAME:-}" ]]; then
            print_image_welcome_page
        fi
    fi
}

########################
# Print the welcome page for a Docker image
#########################
print_image_welcome_page() {
    local github_url="https://github.com/jloehel/docker-${APP_NAME}"

    log ""
    log "${BOLD}Welcome to the ${APP_NAME} container${RESET}"
    log "Subscribe to project updates by watching ${BOLD}${github_url}${RESET}"
    log "Submit issues and feature requests at ${BOLD}${github_url}/issues${RESET}"
    log ""
}

########################
# Ensure directory exists with correct permissions
#########################
ensure_dir() {
    local dir="$1"
    if [[ ! -d "${dir}" ]]; then
        mkdir -p "${dir}"
        chmod 775 "${dir}"
    fi
}
